#!/bin/sh
set -eu

app_dir=${APPDIR:-$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)}
export PATH="$app_dir/usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$app_dir/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# Give the background service its own AppImage runtime. The outer AppImage
# runtime unmounts as soon as its controller exits; a daemon started directly
# from that mount would keep executing against an invalidated SquashFS mapping
# and receive SIGBUS. The private role bypasses controller setup and keeps this
# second mount alive for exactly as long as `noired` runs.
if [ "${NOIRE_APPIMAGE_ROLE:-}" = daemon ]; then
    unset NOIRE_APPIMAGE_ROLE
    exec "$app_dir/usr/bin/noired" "$@"
fi

# Desktop shells do not inherit an AppImage's XDG_DATA_DIRS. Install the tiny
# icon and launcher metadata in the user's data directory so Wayland app-id and
# X11 WM_CLASS lookup both resolve to Noire instead of a generic application.
if [ -n "${HOME:-}" ]; then
    user_data_dir=${XDG_DATA_HOME:-"$HOME/.local/share"}
    icon_dir="$user_data_dir/icons/hicolor/scalable/apps"
    application_dir="$user_data_dir/applications"
    mkdir -p "$icon_dir" "$application_dir"
    icon="$icon_dir/io.github.rayan6ms.Noire.svg"
    icon_updated=false
    icon_tmp=$(mktemp "$icon_dir/.io.github.rayan6ms.Noire.svg.XXXXXX")
    cp "$app_dir/usr/share/icons/hicolor/scalable/apps/io.github.rayan6ms.Noire.svg" \
        "$icon_tmp"
    chmod 0644 "$icon_tmp"
    if [ -f "$icon" ] && cmp -s "$icon_tmp" "$icon"; then
        rm -f "$icon_tmp"
    else
        mv -f "$icon_tmp" "$icon"
        icon_updated=true
    fi
    if [ -n "${APPIMAGE:-}" ]; then
        escaped_appimage=$(printf '%s' "$APPIMAGE" | sed 's/[\\&|]/\\&/g; s/"/\\"/g')
        launcher="$application_dir/io.github.rayan6ms.Noire.desktop"
        launcher_tmp=$(mktemp "$application_dir/.io.github.rayan6ms.Noire.desktop.XXXXXX")
        sed "s|^Exec=noire$|Exec=\"${escaped_appimage}\"|" \
            "$app_dir/usr/share/applications/io.github.rayan6ms.Noire.desktop" \
            >"$launcher_tmp"
        chmod 0644 "$launcher_tmp"
        if [ -f "$launcher" ] && cmp -s "$launcher_tmp" "$launcher"; then
            rm -f "$launcher_tmp"
        else
            mv -f "$launcher_tmp" "$launcher"
        fi
    fi
    if [ "$icon_updated" = true ] && [ -x /usr/bin/gtk-update-icon-cache ]; then
        env -u LD_LIBRARY_PATH /usr/bin/gtk-update-icon-cache -f -t \
            "$user_data_dir/icons/hicolor" >/dev/null 2>&1 || true
    fi
fi

# Informational commands do not need the audio service and may exit before the
# AppImage runtime has mounted long enough for a background daemon to remain.
case "${1:-}" in
    -h|--help|-V|--version) exec "$app_dir/usr/bin/noire" "$@" ;;
esac

# Keep one controller and one tray registration per desktop session. A repeated
# AppImage launch exits quietly before it can race another daemon or create
# another tray icon. Activating a StatusNotifier item without a compositor
# startup token makes GNOME display a broken “null is ready” notification, so a
# headless repeat launch deliberately performs no window activation.
runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
if [ -x /usr/bin/flock ]; then
    lock_file="$runtime_dir/noire-appimage.lock"
    exec 9>"$lock_file"
    if ! /usr/bin/flock -n 9; then
        exit 0
    fi
fi

# Native packages use D-Bus activation. The portable image starts its bundled
# daemon when no installed daemon already owns the service.
if ! "$app_dir/usr/bin/noirectl" status >/dev/null 2>&1; then
    daemon_log="${XDG_RUNTIME_DIR:-/tmp}/noire-appimage.log"
    if [ -n "${APPIMAGE:-}" ] && [ -x "$APPIMAGE" ]; then
        NOIRE_APPIMAGE_ROLE=daemon "$APPIMAGE" 9>&- >>"$daemon_log" 2>&1 &
    else
        "$app_dir/usr/bin/noired" 9>&- >>"$daemon_log" 2>&1 &
    fi
fi

exec "$app_dir/usr/bin/noire" "$@"
