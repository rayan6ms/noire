#!/bin/sh
set -eu

app_dir=${APPDIR:-$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)}
export PATH="$app_dir/usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$app_dir/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
if [ -d "$app_dir/usr/lib/pipewire-0.3" ]; then
    export PIPEWIRE_MODULE_DIR="$app_dir/usr/lib/pipewire-0.3"
fi
if [ -d "$app_dir/usr/lib/spa-0.2" ]; then
    export SPA_PLUGIN_DIR="$app_dir/usr/lib/spa-0.2"
fi
if [ -d "$app_dir/usr/share/pipewire" ]; then
    export PIPEWIRE_CONFIG_DIR="$app_dir/usr/share/pipewire"
fi

# Give the background service its own AppImage runtime. The outer AppImage
# runtime unmounts as soon as its controller exits; a daemon started directly
# from that mount would keep executing against an invalidated SquashFS mapping
# and receive SIGBUS. The private role bypasses controller setup and keeps this
# second mount alive for exactly as long as `noired` runs.
if [ "${NOIRE_APPIMAGE_ROLE:-}" = daemon ]; then
    unset NOIRE_APPIMAGE_ROLE
    exec "$app_dir/usr/bin/noired" "$@"
fi

# An AppImage is portable and must not silently install or overwrite desktop
# launchers. Desktop integration remains an explicit user or AppImage-manager
# choice; the metadata embedded at the AppDir root supports those tools.

# Informational commands do not need the audio service and may exit before the
# AppImage runtime has mounted long enough for a background daemon to remain.
case "${1:-}" in
    -h|--help|-V|--version) exec "$app_dir/usr/bin/noire" "$@" ;;
esac

# Keep one controller and one tray registration per desktop session. A repeated
# AppImage launch exits quietly before it can race another daemon or create
# another tray icon. Activating a StatusNotifier item without a compositor
# startup token makes GNOME display a broken “null is ready” notification, so a
# headless repeat launch deliberately performs no window activation.
runtime_dir=${XDG_RUNTIME_DIR:-}
if [ ! -d "$runtime_dir" ] || [ ! -w "$runtime_dir" ]; then
    runtime_dir=
fi
flock_bin=$(command -v flock || true)
if [ -n "$runtime_dir" ] && [ -n "$flock_bin" ]; then
    lock_file="$runtime_dir/noire-appimage.lock"
    if { exec 9>>"$lock_file"; } 2>/dev/null; then
        if ! "$flock_bin" -n 9; then
            exit 0
        fi
    fi
fi

# Native packages use D-Bus activation. The portable image starts its bundled
# daemon when no installed daemon already owns the service.
if ! "$app_dir/usr/bin/noirectl" status >/dev/null 2>&1; then
    daemon_log=/dev/null
    if [ -n "$runtime_dir" ]; then
        daemon_log="$runtime_dir/noire-appimage.log"
    fi
    if [ -n "${APPIMAGE:-}" ] && [ -x "$APPIMAGE" ]; then
        NOIRE_APPIMAGE_ROLE=daemon env -u LD_LIBRARY_PATH -u XDG_DATA_DIRS \
            -u PIPEWIRE_MODULE_DIR -u SPA_PLUGIN_DIR -u PIPEWIRE_CONFIG_DIR \
            "$APPIMAGE" 9>&- >>"$daemon_log" 2>&1 &
    else
        "$app_dir/usr/bin/noired" 9>&- >>"$daemon_log" 2>&1 &
    fi
fi

exec "$app_dir/usr/bin/noire" "$@"
