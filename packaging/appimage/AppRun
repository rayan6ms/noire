#!/bin/sh
set -eu

app_dir=${APPDIR:-$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)}
export PATH="$app_dir/usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$app_dir/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
if [ -d "$app_dir/usr/lib/pipewire-0.3" ]; then
    export PIPEWIRE_MODULE_DIR="$app_dir/usr/lib/pipewire-0.3"
fi
if [ -d "$app_dir/usr/lib/spa-0.2" ]; then
    export SPA_PLUGIN_DIR="$app_dir/usr/lib/spa-0.2"
fi
if [ -d "$app_dir/usr/share/pipewire" ]; then
    export PIPEWIRE_CONFIG_DIR="$app_dir/usr/share/pipewire"
fi

# Give the background service its own AppImage runtime. The outer AppImage
# runtime unmounts as soon as its controller exits; a daemon started directly
# from that mount would keep executing against an invalidated SquashFS mapping
# and receive SIGBUS. The private role bypasses controller setup and keeps this
# second mount alive for exactly as long as `noired` runs.
if [ "${NOIRE_APPIMAGE_ROLE:-}" = daemon ]; then
    unset NOIRE_APPIMAGE_ROLE
    exec "$app_dir/usr/bin/noired" "$@"
fi

# An AppImage is portable and must not silently install or overwrite desktop
# launchers. Desktop integration remains an explicit user or AppImage-manager
# choice; the metadata embedded at the AppDir root supports those tools.
#
# Noire 1.1.0 did install its canonical launcher automatically. When an
# AppImage manager has integrated the same image, remove that legacy launcher
# only after proving that both files point to this exact AppImage. This works
# regardless of which duplicate the user opens, while leaving native-package
# launchers and unrelated AppImages untouched.
cleanup_legacy_desktop_launcher() {
    [ -n "${APPIMAGE:-}" ] || return 0
    case "$APPIMAGE" in
        /*) ;;
        *) return 0 ;;
    esac

    user_data_dir=${XDG_DATA_HOME:-${HOME:+"$HOME/.local/share"}}
    case "$user_data_dir" in
        /*) ;;
        *) return 0 ;;
    esac
    application_dir="$user_data_dir/applications"
    legacy_launcher="$application_dir/io.github.rayan6ms.Noire.desktop"
    [ -f "$legacy_launcher" ] && [ ! -L "$legacy_launcher" ] || return 0

    legacy_matches=false
    if grep -Fqx "Exec=\"$APPIMAGE\"" "$legacy_launcher" ||
        grep -Fqx "Exec=$APPIMAGE" "$legacy_launcher"
    then
        legacy_matches=true
    fi
    [ "$legacy_matches" = true ] || return 0

    for integrated_launcher in "$application_dir"/*.desktop; do
        [ "$integrated_launcher" != "$legacy_launcher" ] || continue
        [ -f "$integrated_launcher" ] && [ ! -L "$integrated_launcher" ] || continue
        grep -Fqx "TryExec=$APPIMAGE" "$integrated_launcher" || continue
        grep -Fqx "X-AppImage-Name=Noire" "$integrated_launcher" || continue
        rm -f -- "$legacy_launcher"
        return 0
    done
}

cleanup_legacy_desktop_launcher

# Informational commands do not need the audio service and may exit before the
# AppImage runtime has mounted long enough for a background daemon to remain.
case "${1:-}" in
    -h|--help|-V|--version) exec "$app_dir/usr/bin/noire" "$@" ;;
esac

# Keep one controller and one tray registration per desktop session. A repeated
# AppImage launch asks the existing controller to show its window instead of
# racing another daemon or creating another tray icon.
runtime_dir=${XDG_RUNTIME_DIR:-}
if [ ! -d "$runtime_dir" ] || [ ! -w "$runtime_dir" ]; then
    runtime_dir=
fi
flock_bin=$(command -v flock || true)
owns_session_lock=false
activation_file=
if [ -n "$runtime_dir" ] && [ -n "$flock_bin" ]; then
    lock_file="$runtime_dir/noire-appimage.lock"
    activation_file="$runtime_dir/noire-controller.activate"
    if { exec 9>>"$lock_file"; } 2>/dev/null; then
        if ! "$flock_bin" -n 9; then
            activation_request="$activation_file.$$"
            if (umask 077 && printf '%s\n' show >"$activation_request"); then
                mv -f -- "$activation_request" "$activation_file"
            fi
            exit 0
        fi
        owns_session_lock=true
        rm -f -- "$activation_file"
        export NOIRE_ACTIVATION_FILE="$activation_file"
    fi
fi

# A pre-1.1.3 portable daemon could outlive its controller and keep the old
# AppImage mount and D-Bus API alive. Reaching this point proves that no other
# AppImage controller owns the session lock, so stop and terminate only an
# exact same-user noired executable inside an AppImage mount.
cleanup_stale_portable_daemons() {
    current_uid=$(id -u)
    stale_pids=
    for process_dir in /proc/[0-9]*; do
        pid=${process_dir#/proc/}
        [ "$pid" != "$$" ] || continue
        executable=$(readlink "$process_dir/exe" 2>/dev/null || true)
        case "$executable" in
            /tmp/.mount_noire.*/usr/bin/noired|/tmp/.mount_noire.*/usr/bin/noired\ \(deleted\)) ;;
            *) continue ;;
        esac
        process_uid=$(awk '/^Uid:/ { print $2; exit }' "$process_dir/status" 2>/dev/null || true)
        [ "$process_uid" = "$current_uid" ] || continue
        stale_pids="$stale_pids $pid"
    done
    [ -n "$stale_pids" ] || return 0

    "$app_dir/usr/bin/noirectl" stop >/dev/null 2>&1 || true
    for pid in $stale_pids; do
        kill -TERM "$pid" 2>/dev/null || true
    done
    attempt=0
    while [ "$attempt" -lt 20 ]; do
        still_running=false
        for pid in $stale_pids; do
            [ ! -d "/proc/$pid" ] || still_running=true
        done
        [ "$still_running" = true ] || return 0
        sleep 0.05
        attempt=$((attempt + 1))
    done
    echo "Noire could not stop its stale portable background service." >&2
    return 1
}

if [ "$owns_session_lock" = true ] && [ "$runtime_dir" = "/run/user/$(id -u)" ]; then
    cleanup_stale_portable_daemons
fi

# Native packages use D-Bus activation. The portable image starts its bundled
# daemon when no installed daemon already owns the service.
if ! "$app_dir/usr/bin/noirectl" status >/dev/null 2>&1; then
    daemon_log=/dev/null
    if [ -n "$runtime_dir" ]; then
        daemon_log="$runtime_dir/noire-appimage.log"
    fi
    if [ -n "${APPIMAGE:-}" ] && [ -x "$APPIMAGE" ]; then
        NOIRE_APPIMAGE_ROLE=daemon NOIRE_PORTABLE_CONTROLLER_PID=$$ \
            env -u LD_LIBRARY_PATH -u XDG_DATA_DIRS \
            -u PIPEWIRE_MODULE_DIR -u SPA_PLUGIN_DIR -u PIPEWIRE_CONFIG_DIR \
            "$APPIMAGE" 9>&- >>"$daemon_log" 2>&1 &
    else
        "$app_dir/usr/bin/noired" 9>&- >>"$daemon_log" 2>&1 &
    fi
fi

exec "$app_dir/usr/bin/noire" "$@"
