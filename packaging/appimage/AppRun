#!/bin/sh
set -eu

app_dir=${APPDIR:-$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)}
export PATH="$app_dir/usr/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$app_dir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$app_dir/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# Informational commands do not need the audio service and may exit before the
# AppImage runtime has mounted long enough for a background daemon to remain.
case "${1:-}" in
    -h|--help|-V|--version) exec "$app_dir/usr/bin/noire" "$@" ;;
esac

# Native packages use D-Bus activation. The portable image starts its bundled
# daemon when no installed daemon already owns the service.
if ! "$app_dir/usr/bin/noirectl" status >/dev/null 2>&1; then
    "$app_dir/usr/bin/noired" >>"${XDG_RUNTIME_DIR:-/tmp}/noire-appimage.log" 2>&1 &
fi

exec "$app_dir/usr/bin/noire" "$@"
